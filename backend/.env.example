# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=careerforge_db
DB_CONNECTION_LIMIT=10

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and frontend-facing redirects/links)
# Local: http://localhost:5173
# Production: http://careerforge-frontend-2026.s3-website-ap-southeast-2.amazonaws.com
CLIENT_URL=http://localhost:5173

# Public Backend URL (for OAuth callbacks and email-based document verification)
# Local: http://localhost:5000
# Production: http://13.238.22.215
BACKEND_URL=http://localhost:5000

# Email Service Configuration
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password
DOCUMENT_VERIFICATION_EMAIL=careerforge.verify@gmail.com

# Google OAuth Configuration (server-only; never expose these to the frontend)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Optional LLM Enhancement Configuration
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=25000
